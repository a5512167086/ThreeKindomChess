# 複製成 .env 再填。.env 不會進 git，不要把真的密碼寫在這個檔案裡。

# 玩家在瀏覽器網址列看到的網址（開發時是 Vite 的網址）
PUBLIC_ORIGIN=http://localhost:5173

# PostgreSQL 連線字串（例如 Neon）。不填就用本機的 PGlite，資料存在 .data/pglite
# DATABASE_URL=postgresql://帳號:密碼@主機/資料庫?sslmode=require

# Google 登入：到 Google Cloud Console 建「OAuth 用戶端 ID」（網頁應用程式）
# 已授權的重新導向 URI 要填：http://localhost:5173/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 藍新金流（台灣玩家，台幣）：商店管理 → 商店資料設定 → API 串接金鑰。
# 先到測試平台 https://cwww.newebpay.com 申請測試商店；正式商店的金鑰拿到後再設 NEWEBPAY_LIVE=1。
# 背景通知會打 $PUBLIC_ORIGIN/billing/newebpay/notify，本機開發收不到也沒關係（付完款導回來時也會處理）
# NEWEBPAY_MERCHANT_ID=
# NEWEBPAY_HASH_KEY=
# NEWEBPAY_HASH_IV=
# NEWEBPAY_LIVE=1

# PayPal（海外玩家，美金）：https://developer.paypal.com → Apps & Credentials 建一個 App。
# 預設用 Sandbox 的金鑰；換成 Live 的金鑰後再設 PAYPAL_LIVE=1
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_LIVE=1

# 開發用的假訂閱：設成 1 就能在「我的棋譜」直接訂閱（不收費）。正式上線不要設
# FAKE_BILLING=1
